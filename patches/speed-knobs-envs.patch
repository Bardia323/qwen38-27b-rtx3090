Register the single-user speed knobs as vLLM env vars (vLLM 0.27.1).

VLLM_MARLIN_TUNE / VLLM_MARLIN_TUNE_DIR (tuned Marlin build, see marlin-tune/),
VLLM_SPEC_DECODE_ATTN (patches/spec-decode-attn.patch) and VLLM_DRAFT_TOPK_TOPP
(patches/sampler-small-topk-fast-softmax.patch). Every registered vLLM env var is
part of the torch.compile cache key; VLLM_MARLIN_TUNE in particular changes the
Marlin workspace tensor shape that is baked into the compiled graph, so without
this a cached graph from a run without the flag fails with
"assert_size_stride ... expected size 328==82". Apply AFTER
marlin-int8-layer-select.patch (same file):
  patch -p1 -d venv/lib/python3.12/site-packages/vllm < patches/speed-knobs-envs.patch

--- a/envs.py	2026-08-18 12:27:02.452638786 +0200
+++ b/envs.py	2026-08-18 12:27:02.460387254 +0200
@@ -179,6 +179,10 @@
     VLLM_MARLIN_INPUT_DTYPE: Literal["int8", "fp8"] | None = None
     VLLM_MARLIN_INT8_INCLUDE_RE: str = ""
     VLLM_MARLIN_INT8_EXCLUDE_RE: str = "lm_head|mtp"
+    VLLM_MARLIN_TUNE: bool = False
+    VLLM_MARLIN_TUNE_DIR: str = ""
+    VLLM_SPEC_DECODE_ATTN: bool = False
+    VLLM_DRAFT_TOPK_TOPP: bool = True
     VLLM_HUMMING_ONLINE_QUANT_CONFIG: dict[str, Any] | None = None
     VLLM_HUMMING_INPUT_QUANT_CONFIG: dict[str, Any] | None = None
     VLLM_HUMMING_USE_F16_ACCUM: bool = False
@@ -1465,6 +1469,12 @@
     "VLLM_MARLIN_INT8_EXCLUDE_RE": lambda: os.environ.get(
         "VLLM_MARLIN_INT8_EXCLUDE_RE", "lm_head|mtp"
     ),
+    # syv patch: single-user speed knobs (registered so they take part in the
+    # torch.compile cache key; VLLM_MARLIN_TUNE changes the Marlin workspace shape)
+    "VLLM_MARLIN_TUNE": lambda: os.environ.get("VLLM_MARLIN_TUNE", "0") == "1",
+    "VLLM_MARLIN_TUNE_DIR": lambda: os.environ.get("VLLM_MARLIN_TUNE_DIR", ""),
+    "VLLM_SPEC_DECODE_ATTN": lambda: os.environ.get("VLLM_SPEC_DECODE_ATTN", "0") == "1",
+    "VLLM_DRAFT_TOPK_TOPP": lambda: os.environ.get("VLLM_DRAFT_TOPK_TOPP", "1") == "1",
     # The online quantization dtype for humming kernel
     "VLLM_HUMMING_ONLINE_QUANT_CONFIG": lambda: maybe_convert_json_str_or_file(
         os.environ.get("VLLM_HUMMING_ONLINE_QUANT_CONFIG", None)
